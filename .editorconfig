# Matches what the files in this repository already do — see CONTRIBUTING.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ps1,psd1,psm1}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.lua]
indent_size = 4

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = true

**/__pycache__/
*.py[cod]
.DS_Store

# Tool caches. Anchored with **/ so they are ignored wherever they appear —
# test-env/python/ is a tracked directory that these otherwise buried.
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
.venv/

# Isolated git worktrees created by Claude Code subagents. Transient, and each
# one is a full second checkout of this repository — never commit them.
# Scoped to worktrees/ rather than all of .claude/ so project-level config
# (settings.json, agents, skills) can still be tracked deliberately.
.claude/worktrees/

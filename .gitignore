**/__pycache__/
*.py[cod]
.DS_Store

# Tool caches. Anchored with **/ so they are ignored wherever they appear —
# test-env/python/ is a tracked directory that these otherwise buried.
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
.venv/

# Isolated worktrees created by coding tools that support them. Transient,
# and each one is a full second checkout of this repository - never commit
# them. Scoped to the worktrees directory rather than the whole config dir,
# so project-level config can still be tracked deliberately.
*/worktrees/

# Local coding-agent state. Every agent keeps its skills, settings and scratch
# in a dot-directory at the repository root, and that belongs to the machine
# running it, not the published tree: the skills restate CONTRIBUTING.md and
# stay local. Ignoring every root dot-directory covers each agent without
# naming any; .github/ is the one such directory that is part of the
# repository, so it is re-admitted. A future tracked dot-directory needs its
# own negation line here, or git will quietly leave it out.
/.*/
!/.github/
# The remote-session startup hook is the exception: a remote session starts
# from a bare clone, so the hook that prepares it has to be in the tree. Only
# the hook and the settings file that registers it are tracked; everything
# else the agent keeps in that directory stays local.
!/.claude/
/.claude/*
!/.claude/hooks/
!/.claude/settings.json

# Local agent instructions belong to the machine running them, not the repo.
AGENTS.md
WS/*

# Local scratch workspace; its directory name begins with a space.
[ ]WS/

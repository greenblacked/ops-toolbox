# Canonical RouterOS CHR version used by the Docker integration suite and CI.
ROUTEROS_VERSION=7.24.1
# SHA-256 of chr-<version>.vdi.zip as published by MikroTik.
#
# The image becomes a booting kernel with the repository mounted, so it is the
# one artifact in this project that most needs pinning — the Alpine base and
# every GitHub Action already are. `test -s` only proved the download was
# non-empty, which a hijacked mirror or a TLS-terminating proxy also satisfies.
#
# run.sh refuses to start without one. Emptying this line does not fall back to
# an unverified download, it stops the suite — a bump records the new digest
# before it moves the version above, so "empty" can only mean the pin was lost.
#
# Record or refresh with:  mikrotik/tests/routeros_version.py record-hash
ROUTEROS_SHA256=d7e1e68ab79b65974b6ae82b15e013ce6f94112b019a7842c0e8465a6d11d792

# Show the namespace of the current context, or set it for subsequent commands.
# The explicit function avoids a shell-global KUBE_NAMESPACE variable that
# would silently disagree with kubectl in another terminal.
kns() {
    if [ "$#" -eq 0 ]; then
        local namespace
        namespace="$(kubectl config view --minify --output='jsonpath={..namespace}' 2>/dev/null)" || return 1
        printf '%s\n' "${namespace:-default}"
        return 0
    fi
    if [ "$#" -ne 1 ]; then
        printf 'Usage: kns [namespace]\n' >&2
        return 3
    fi
    kubectl config set-context --current --namespace="$1"
}


# ---------------------------------------------------------------------------
alias g='git'
alias gs='git status --short --branch'
alias gst='git status'

alias ga='git add'
alias gaa='git add --all'
alias gap='git add --patch'
alias gau='git add --update'

alias gc='git commit'
alias gcm='git commit -m'
alias gca='git commit --amend'
alias gcan='git commit --amend --no-edit'

alias gd='git diff'
alias gds='git diff --staged'
alias gdw='git diff --word-diff'

alias gf='git fetch'
alias gfa='git fetch --all --prune'
alias gfp='git fetch --prune'

alias gl='git pull --rebase'
alias gpl='git pull'
alias gpr='git pull --rebase'

alias gp='git push'
alias gpu='git push --set-upstream origin HEAD'
alias gpf='git push --force-with-lease'

alias gb='git branch'
alias gba='git branch --all'
alias gbv='git branch --verbose --verbose'
alias gbd='git branch --delete'
alias gbD='git branch --delete --force'

alias gco='git checkout'
alias gcob='git checkout -b'

alias gsw='git switch'
alias gswc='git switch --create'
alias gswm='git switch main'
alias gswd='git switch develop'
alias gswp='git switch -'

alias gm='git merge'
alias gma='git merge --abort'
alias gmc='git merge --continue'
alias gmff='git merge --ff-only'
alias gmnoff='git merge --no-ff'

alias gr='git rebase'
alias gri='git rebase --interactive'
alias gra='git rebase --abort'
alias grc='git rebase --continue'
alias grs='git rebase --skip'
alias grm='git rebase main'
alias gro='git rebase origin/main'

alias grst='git restore'
alias grsts='git restore --staged'
alias grstp='git restore --patch'

alias grh='git reset HEAD'
alias grhs='git reset --soft HEAD~1'
alias grhm='git reset --mixed HEAD~1'

alias gclean='git clean -nd'
alias gcleanf='git clean -fd'

alias gsh='git show'
alias gshow='git show --stat'
alias glast='git log -1 --stat'
alias gone='git log -1 --oneline'

alias glog='git log --graph --decorate --oneline --all'
alias gloga='git log --graph --decorate --oneline --all --stat'
alias glogp='git log --graph --decorate --oneline --all --patch'

alias gstash='git stash push'
alias gstashm='git stash push -m'
alias gstashu='git stash push --include-untracked'
alias gstashl='git stash list'
alias gstashp='git stash pop'
alias gstasha='git stash apply'
alias gstashd='git stash drop'
alias gstashs='git stash show --patch'

alias gremote='git remote --verbose'
alias gorigin='git remote get-url origin'

alias gtag='git tag'
alias gtags='git tag --sort=-version:refname'
alias gtagp='git push origin --tags'

alias gcherry='git cherry-pick'
alias gcherrya='git cherry-pick --abort'
alias gcherryc='git cherry-pick --continue'

alias gsub='git submodule'
alias gsubu='git submodule update --init --recursive'

gbranch() {
    git branch --show-current
}

gnew() {
    if [ "$#" -ne 1 ]; then
        printf 'Usage: gnew <branch-name>\n'
        return 1
    fi
    git switch --create "$1"
}

gpublish() {
    local branch
    branch="$(git branch --show-current)"
    if [ -z "$branch" ]; then
        printf 'Cannot determine current branch.\n'
        return 1
    fi
    git push --set-upstream origin "$branch"
}

gchanged() {
    git diff --name-status main...HEAD
}

gupdatemain() {
    local current_branch
    current_branch="$(git branch --show-current)"
    git switch main || return 1
    git pull --rebase origin main || return 1
    if [ "$current_branch" != "main" ]; then
        git switch "$current_branch"
    fi
}

# Stage all, commit with a "[branch] " prefix, and push. Distinct from
# ../git/gacp.sh in this repo (that script supports --dry-run/--no-push and
# doesn't prefix the message) — this is the interactive-shell shortcut.
gacp() {
    local branch
    local message

    branch="$(git branch --show-current 2>/dev/null)"
    if [ -z "$branch" ]; then
        printf 'Error: not inside a Git repository or currently in detached HEAD state.\n'
        return 1
    fi

    if [ "$#" -eq 0 ]; then
        printf 'Usage: gacp "commit message"\n'
        return 1
    fi
    message="$*"

    git add --all || return 1
    git commit -m "[$branch] $message" || return 1

    if git rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
        git push
    else
        git push --set-upstream origin "$branch"
    fi
}

# Open the current repo's remote (GitLab, GitHub, ...) in the default
# browser, converting an SSH remote (git@host:owner/repo.git) to https first.
# Works without `glab` installed — see `glrepow` below for the glab version.
# Usage: glopen [remote]   (defaults to "origin")
glopen() {
    local remote url host path
    remote="${1:-origin}"
    url=$(git remote get-url "$remote" 2>/dev/null) || {
        echo "glopen: no remote named '$remote' in this repo" >&2
        return 1
    }
    url=${url%.git}
    if [[ $url == git@*:* ]]; then
        host=${url#git@}
        host=${host%%:*}
        path=${url#*:}
        url="https://$host/$path"
    fi
    explorer.exe "$url" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# GitLab CLI: glab
# ---------------------------------------------------------------------------
# Only defined if `glab` is actually installed so they don't dangle as
# broken aliases on a machine without it.
if command -v glab >/dev/null 2>&1; then
    alias glabv='glab version'
    alias glauth='glab auth status'
    alias glauthlogin='glab auth login'

    alias glrepo='glab repo view'
    alias glrepow='glab repo view --web'
    alias glclone='glab repo clone'

    alias glmr='glab mr'
    alias glmrl='glab mr list'
    alias glmra='glab mr list --assignee=@me'
    alias glmrr='glab mr list --reviewer=@me'
    alias glmrm='glab mr list --mine'
    alias glmrv='glab mr view'
    alias glmrw='glab mr view --web'
    alias glmrc='glab mr create'
    alias glmrd='glab mr diff'
    alias glmrapprove='glab mr approve'
    alias glmrmerge='glab mr merge'
    alias glmrclose='glab mr close'
    alias glmrreopen='glab mr reopen'
    alias glmrcheckout='glab mr checkout'
    alias glmrnote='glab mr note'

    alias gli='glab issue'
    alias glil='glab issue list'
    alias gliassigned='glab issue list --assignee=@me'
    alias glic='glab issue create'
    alias gliv='glab issue view'
    alias gliw='glab issue view --web'
    alias gliclose='glab issue close'
    alias glireopen='glab issue reopen'
    alias glinote='glab issue note'

    alias glpipe='glab pipeline'
    alias glpl='glab pipeline list'
    alias glpv='glab pipeline view'
    alias glprun='glab pipeline run'
    alias glpretry='glab pipeline retry'
    alias glpcancel='glab pipeline cancel'
    alias glpstatus='glab ci status'

    alias glci='glab ci'
    alias glciv='glab ci view'
    alias glcitrace='glab ci trace'
    alias glcilint='glab ci lint'

    alias glrelease='glab release'
    alias glreleasel='glab release list'
    alias glreleasev='glab release view'
    alias glreleasec='glab release create'

    alias glvar='glab variable'
    alias glvarl='glab variable list'
    alias glvarg='glab variable get'
    alias glvars='glab variable set'

    alias glapi='glab api'

    glmrcreate() {
        local branch
        branch="$(git branch --show-current)"
        if [ -z "$branch" ]; then
            printf 'Cannot determine current branch.\n'
            return 1
        fi
        glab mr create \
            --source-branch "$branch" \
            --target-branch main \
            --fill
    }

    glmrdraft() {
        local branch
        branch="$(git branch --show-current)"
        if [ -z "$branch" ]; then
            printf 'Cannot determine current branch.\n'
            return 1
        fi
        glab mr create \
            --source-branch "$branch" \
            --target-branch main \
            --fill \
            --draft
    }

    glpipeline() {
        local branch
        branch="$(git branch --show-current)"
        if [ -z "$branch" ]; then
            printf 'Cannot determine current branch.\n'
            return 1
        fi
        glab pipeline list --branch "$branch"
    }

    glrun() {
        local branch
        branch="$(git branch --show-current)"
        if [ -z "$branch" ]; then
            printf 'Cannot determine current branch.\n'
            return 1
        fi
        glab pipeline run --branch "$branch"
    }
fi


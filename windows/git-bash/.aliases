alias ipconfig='ipconfig.exe'
alias flushdns='ipconfig.exe /flushdns'
alias ports='netstat.exe -ano'
alias listening='netstat.exe -ano | grep LISTENING'
alias tasks='tasklist.exe'

# ---------------------------------------------------------------------------
# Safer file operations
# ---------------------------------------------------------------------------
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

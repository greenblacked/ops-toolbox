# ~/.aliases — sourced from .bashrc
#
# All interactive aliases/functions live here so .bashrc stays focused on
# environment setup. Reuses $SSH_KEY and $CODING_DIR, both left set (not
# unset) by .bashrc for exactly this purpose.

# ---------------------------------------------------------------------------
# Windows-style commands
# ---------------------------------------------------------------------------
alias e='explorer.exe .'
alias explorer='explorer.exe'
alias codehere='code.exe .'
alias notepad='notepad.exe'
alias pwdw='pwd -W'
alias copypwd='pwd -W | clip.exe'

# ---------------------------------------------------------------------------
# Navigation
# ---------------------------------------------------------------------------
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

alias home='cd "$HOME"'
alias coding='cd "$CODING_DIR"'
alias sshdir='cd "$CODING_DIR/ssh"'
alias desktop='cd "$HOME/Desktop"'
alias downloads='cd "$HOME/Downloads"'

# Create a directory and cd into it in one step.
mkcd() {
    if [ "$#" -ne 1 ]; then
        printf 'Usage: mkcd <directory>\n'
        return 1
    fi
    mkdir -p -- "$1" && cd -- "$1"
}

# cd to the current repo's top level.
croot() {
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
        printf 'Not inside a Git repository.\n'
        return 1
    }
    cd "$root"
}

# ---------------------------------------------------------------------------
# File listing and search
# ---------------------------------------------------------------------------
alias ls='ls -F --color=auto --group-directories-first'
alias ll='ls -alFh'
alias la='ls -A'
alias l='ls -CF'
alias lt='ls -laht'
alias lsize='ls -lahS'

alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'

# Find files by name under the current directory.
ff() {
    if [ "$#" -eq 0 ]; then
        printf 'Usage: ff <filename>\n'
        return 1
    fi
    find . -type f -iname "*$1*" 2>/dev/null
}

# Find text inside files under the current directory.
ftext() {
    if [ "$#" -eq 0 ]; then
        printf 'Usage: ftext <text>\n'
        return 1
    fi
    grep -RIn \
        --exclude-dir=.git \
        --exclude-dir=node_modules \
        -- "$1" .
}

# ---------------------------------------------------------------------------
# Shell configuration
# ---------------------------------------------------------------------------
# Plain `clear` in Windows Terminal/ConHost only blanks the visible screen —
# scrolling up still shows everything. `\e[3J` also drops the scrollback, so
# `clear`/`cls`/`c` behave like cmd.exe's `cls`.
alias clear='command clear; printf "\e[3J"'
alias cls='clear'
alias cl='clear'
alias c='clear'

# Reload .bashrc without opening a new window (two names, same thing).
alias src='source "$HOME/.bashrc"'
alias reload='source "$HOME/.bashrc"'

alias editaliases='notepad.exe "$HOME/.aliases"'
alias editbashrc='notepad.exe "$HOME/.bashrc"'
alias editprofile='notepad.exe "$HOME/.bash_profile"'
alias editssh='notepad.exe "$HOME/.ssh/config"'
alias path='printf "%s\n" "$PATH" | tr ":" "\n"'

# `explorer .` from Git Bash needs the Windows path, not the MSYS one.
alias open='explorer.exe "$(pwd -W 2>/dev/null || pwd)"'


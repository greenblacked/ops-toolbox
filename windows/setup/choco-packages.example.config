<?xml version="1.0" encoding="utf-8"?>
<!--
  Example package set for choco_bootstrap.ps1. Copy to choco-packages.config
  next to the script and edit; the copy is what install/check/diff read.

  This is Chocolatey's own packages.config format, so it also works directly:
      choco install choco-packages.config -y

  Four entries differ from the list this was ported from, because that list
  dated from 2020 and those four no longer do what they say:

    microsoft-teams.install  ->  microsoft-teams-new-bootstrapper
        The classic Teams client was blocked in October 2024 and became
        unavailable in July 2025, so the old id installs a dead product.
    sublimetext3             ->  sublimetext4
        Sublime Text is on 4; the 3 package is a stale major version.
    jre8, jdk8, openjdk8     ->  temurin21
        All three were installed together: two Oracle-licensed runtimes whose
        package pages now require a licence for commercial use, plus an
        OpenJDK 8 package that is deprecated and redirects to Temurin anyway.
        Three JVMs on one machine also means three JAVA_HOME and PATH entries
        competing. One current LTS JDK replaces the set.
    pester -version 2.0.2    ->  dropped
        A test framework rather than a desktop tool, pinned to a 2013-era
        version. Pester 5 rewrote the syntax; nothing here depends on it.
-->
<packages>
  <package id="7zip" />
  <package id="adobereader" />
  <package id="awscli" />
  <package id="azure-cli" />
  <package id="bitwarden" />
  <package id="checksum" />
  <package id="choco-cleaner" />
  <package id="choco-package-list-backup" />
  <package id="chromium" />
  <package id="conemu" />
  <package id="cyberduck" />
  <package id="dbeaver" />
  <package id="doublecmd" />
  <package id="drawio" />
  <package id="everything" />
  <package id="firefox" />
  <package id="git" />
  <package id="jq" />
  <package id="keepass" />
  <package id="lightshot" />
  <package id="microsoft-teams-new-bootstrapper" />
  <package id="mobaxterm" />
  <package id="notepadplusplus" />
  <package id="notion" />
  <package id="openssl.light" />
  <package id="openvpn" />
  <package id="pgadmin4" />
  <package id="postman" />
  <package id="powershell-core" />
  <package id="putty" />
  <package id="python" />
  <package id="slack" />
  <package id="spotify" />
  <package id="sublimetext4" />
  <package id="telegram" />
  <package id="temurin21" />
  <package id="tightvnc" />
  <package id="tortoisegit" />
  <package id="vnc-viewer" />
  <package id="vscode" />
  <package id="vscode-icons" />
  <package id="vscode-powershell" />
  <package id="wget" />
  <package id="zoom" />
</packages>

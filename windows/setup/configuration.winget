# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
#
# Curated Windows workstation, applied with:
#     winget configure --file configuration.winget
#
# This is the intent. winget-packages.json, written by winget_bootstrap.ps1
# export, is the fact - what a particular machine happens to have. Keep both:
# one rebuilds a machine, the other records one.
#
# Schema is 0.2 deliberately. The v3 schema needs WinGet 1.11 or newer with the
# dscv3 processor, which is a narrower floor than this repository targets, and
# a machine below it fails with a DSC error rather than a clear one. Moving to
# v3 is a one-file change once 1.11+ is a safe assumption; winget_configure.ps1
# checks the version either way.
#
# Six groups, so a machine can be provisioned partially by commenting a block
# out rather than by editing a flat list:
#   core           the things every machine gets
#   work           editors, source control, databases, remote access
#   communication  chat and calls
#   media          music, screenshots, documents
#   utilities      optional, useful, not required
#
# Deliberately NOT here:
#   kubectl, helm, k9s, jq, yq, terraform, Go, awscli, azure-cli
#     These are Linux tooling. They belong inside WSL, where linux/ already
#     installs and tests them, rather than as a second native copy that drifts.
#   vscode-icons, vscode-powershell
#     VS Code extensions, not applications. A package manager is the wrong
#     place for them; VS Code's own settings sync is the right one.
#   checksum, choco-cleaner, choco-package-list-backup
#     Chocolatey's own tooling, meaningless without Chocolatey.
properties:
  configurationVersion: 0.2.0

  assertions:
    - resource: Microsoft.Windows.Developer/OsVersion
      directives:
        description: Windows 10 21H2 or newer
        allowPrerelease: true
      settings:
        MinVersion: '10.0.22000'

  resources:

    # --- core ---------------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: sevenzip
      directives: { description: '7-Zip', allowPrerelease: true }
      settings: { id: 7zip.7zip, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: firefox
      directives: { description: 'Firefox', allowPrerelease: true }
      settings: { id: Mozilla.Firefox, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: terminal
      directives: { description: 'Windows Terminal - replaces ConEmu', allowPrerelease: true }
      settings: { id: Microsoft.WindowsTerminal, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pwsh
      directives: { description: 'PowerShell 7', allowPrerelease: true }
      settings: { id: Microsoft.PowerShell, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: bitwarden
      directives: { description: 'Bitwarden - the one password manager', allowPrerelease: true }
      settings: { id: Bitwarden.Bitwarden, source: winget }

    # --- work ---------------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: git
      directives: { description: 'Git', allowPrerelease: true }
      settings: { id: Git.Git, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vscode
      directives: { description: 'Visual Studio Code', allowPrerelease: true }
      settings: { id: Microsoft.VisualStudioCode, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: python
      directives: { description: 'Python 3', allowPrerelease: true }
      settings: { id: Python.Python.3.12, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: temurin
      directives: { description: 'Temurin JDK 21 - one JVM, not three', allowPrerelease: true }
      settings: { id: EclipseAdoptium.Temurin.21.JDK, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: dbeaver
      directives: { description: 'DBeaver', allowPrerelease: true }
      settings: { id: dbeaver.dbeaver, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: postman
      directives: { description: 'Postman', allowPrerelease: true }
      settings: { id: Postman.Postman, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: openvpn
      directives: { description: 'OpenVPN', allowPrerelease: true }
      settings: { id: OpenVPNTechnologies.OpenVPN, source: winget }

    # --- communication ------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: slack
      directives: { description: 'Slack', allowPrerelease: true }
      settings: { id: SlackTechnologies.Slack, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: telegram
      directives: { description: 'Telegram', allowPrerelease: true }
      settings: { id: Telegram.TelegramDesktop, source: winget }

    # --- media --------------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: spotify
      directives: { description: 'Spotify', allowPrerelease: true }
      settings: { id: Spotify.Spotify, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: sharex
      directives: { description: 'ShareX - replaces Lightshot', allowPrerelease: true }
      settings: { id: ShareX.ShareX, source: winget }

    # --- utilities ----------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: everything
      directives: { description: 'Everything search', allowPrerelease: true }
      settings: { id: voidtools.Everything, source: winget }

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: notepadplusplus
      directives: { description: 'Notepad++', allowPrerelease: true }
      settings: { id: Notepad++.Notepad++, source: winget }

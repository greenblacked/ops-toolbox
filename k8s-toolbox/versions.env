# Pinned toolchain versions for the k8s-toolbox image.
# Bump deliberately: a release on somebody else's schedule should not turn a
# green repository red. build.sh and the Dockerfile both source this file.
YQ_VERSION=v4.53.3
KUBECTL_VERSION=v1.36.3
HELM_VERSION=v4.2.3
KUSTOMIZE_VERSION=v5.8.1
GCLOUD_VERSION=579.0.0

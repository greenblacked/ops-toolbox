# Dotfiles are sourced by a real bash: force LF regardless of the user's
# core.autocrlf setting, so a checkout never reintroduces the CRLF corruption
# that broke backslash line-continuations in windows/git-bash/.bashrc.
#
# These patterns contain a slash, so git anchors them to the repository root and
# they do NOT match the nested copies under default-git-bash/ — those need their
# own rules, below. `git check-attr eol -- <path>` is the way to confirm.
windows/git-bash/.bashrc text eol=lf
windows/git-bash/.bash_profile text eol=lf
windows/git-bash/.aliases text eol=lf

windows/git-bash/default-git-bash/.bashrc text eol=lf
windows/git-bash/default-git-bash/.bash_profile text eol=lf
windows/git-bash/default-git-bash/.aliases text eol=lf

# Shell scripts everywhere else in the repo are also only ever run by bash.
*.sh text eol=lf
*.zsh text eol=lf

# PowerShell 5.1 and 7 both read LF fine, and pinning it keeps diffs clean on a
# repository edited from macOS and Linux as well as Windows.
*.ps1 text eol=lf
*.psd1 text eol=lf
*.psm1 text eol=lf

# RouterOS pastes the script body into a device; the Python helpers run from
# /usr/bin/python3 on macOS.
*.lua text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Every pull request adds its entry at the top of the Unreleased section, so
# any two open at once collide on the same lines and the second to merge
# conflicts. union keeps both sides' insertions instead of stopping; it is
# safe here because the only edit pattern is a whole bullet inserted, never a
# line changed in place. Order between two merged-together entries may need a
# glance, which is cheaper than a conflict per pull request.
CHANGELOG.md merge=union

# Everything under dotfiles/ is read by a tool on macOS or Linux - ssh, gpg,
# git, starship - and a CRLF in any of them is a parse error or a silently
# ignored line. The trees are linked into the home directory as-is.
dotfiles/** text eol=lf

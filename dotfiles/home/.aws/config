# AWS CLI v2 settings (~/.aws/config). Installed as a COPY: `aws configure`
# rewrites the file. Keys, if any, belong in ~/.aws/credentials, mode 600 and
# never in a repository; an IAM Identity Center session needs neither.
# Verified against awscli/topics/config-vars.rst and the CLI user guide.

[default]
region = eu-central-1
# json is what scripts and jq expect; `--output table` for a human read.
output = json
# v2 pipes every result through less. An empty value turns that off, which
# is what stops `aws ... | jq` and every CI job from hanging on a pager.
cli_pager =
# Prompt for completions only when a command is incomplete, so a full
# command still runs unattended.
cli_auto_prompt = on-partial
# `standard` applies the SDK-wide retry rules with a retry quota; `legacy`
# is still the CLI default. Five attempts rides out a throttling burst.
retry_mode = standard
max_attempts = 5

# IAM Identity Center. One browser login for every profile that shares the
# session; nothing static on disk. Fill in the start URL and account IDs:
#
# [sso-session corp]
# sso_start_url = https://example.awsapps.com/start
# sso_region = eu-central-1
# sso_registration_scopes = sso:account:access
#
# [profile dev]
# sso_session = corp
# sso_account_id = 111111111111
# sso_role_name = DeveloperAccess
# region = eu-central-1
#
# Then: aws sso login --sso-session corp

# Credentials from a helper such as aws-vault or 1Password, so nothing sits
# in ~/.aws/credentials at all. The command must print the JSON shape in
# the user guide under "Sourcing credentials with an external process".
# [profile vaulted]
# credential_process = /opt/homebrew/bin/aws-vault export --format=json vaulted

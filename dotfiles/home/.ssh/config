# OpenSSH client. The first value set for an option wins, so per-host
# blocks and the Include line come BEFORE the Host * defaults.
#
# Per-host blocks - bastions, client environments, keys per organisation -
# go in ~/.ssh/config.d/, which is included below and never tracked. Every
# option here is in ssh_config(5) of OpenSSH 8.6 (macOS 12) or later; the
# one Apple addition is guarded by IgnoreUnknown.

IgnoreUnknown UseKeychain
Include ~/.ssh/config.d/*

Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    # git opens many short connections; a multiplexed master gains little
    # and holds a socket open to github.com for no reason.
    ControlMaster no

Host *
    # Load a key into the agent the first time it is used, and on macOS
    # take its passphrase from the Keychain. No ssh-add after a reboot.
    AddKeysToAgent yes
    UseKeychain yes
    # Offer only the configured key, not every key the agent holds. Stops
    # "Too many authentication failures" and stops a server learning which
    # other keys you carry.
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    # A probe every 30s and three misses before giving up keeps a session
    # alive through NAT and VPN idle timeouts, and notices a dead one in
    # under two minutes instead of never.
    ServerAliveInterval 30
    ServerAliveCountMax 3
    # Reuse one connection per host for ten minutes after the last session
    # closes: the second ssh, scp or rsync to a bastion is instant. %C is a
    # hash of the connection, so the socket name stays short and private.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    # Hostnames in known_hosts are hashed, so a leaked file does not list
    # every machine you have ever reached.
    HashKnownHosts yes
    # Ask about a new host key, refuse a changed one. Never "no".
    StrictHostKeyChecking ask
    # Accept rotated host keys the server announces over the existing,
    # authenticated connection.
    UpdateHostKeys yes
    # Forwarding is per-host, opted into in config.d/. A forwarded agent
    # lets root on that host sign as you.
    ForwardAgent no
    ForwardX11 no
    # Trim the defaults rather than replace them, so the list is right on
    # every OpenSSH version. Gone: SHA-1 anywhere, the non-ETM MACs, and
    # the NIST curves. A legacy appliance gets its own Host block.
    KexAlgorithms -ecdh-sha2-nistp*,diffie-hellman-group14-sha1,diffie-hellman-group-exchange-sha1,diffie-hellman-group1-sha1
    Ciphers -aes128-ctr,aes192-ctr,3des-cbc,aes*-cbc
    MACs -hmac-sha1*,umac-64*,hmac-sha2-256,hmac-sha2-512,umac-128@openssh.com,hmac-md5*

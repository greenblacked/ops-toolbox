# kubectl preferences - aliases and default flags, no cluster details.
#
# Read from ~/.kube/kuberc (or $KUBERC). Beta since Kubernetes 1.34; earlier
# kubectl versions ignore the file. This is the one file under ~/.kube that
# is safe to keep in a repository: ~/.kube/config holds credentials and
# stays out. Defaults here apply to scripts too, which is why nothing below
# changes what a plain command does - only the aliases add behaviour.
apiVersion: kubectl.config.k8s.io/v1beta1
kind: Preference
aliases:
  # `kubectl getj pods` - JSON output for jq without the flag.
  - name: getj
    command: get
    options:
      - name: output
        default: json
  # `kubectl gety deployment app` - YAML with the noise left in; pipe
  # through `kubectl neat` for a copy you can apply elsewhere.
  - name: gety
    command: get
    options:
      - name: output
        default: yaml
  # `kubectl rmi pod x` - delete that asks first. The plain `delete` is
  # left alone so existing scripts behave as they always did.
  - name: rmi
    command: delete
    options:
      - name: interactive
        default: "true"

# npm user settings. No registry token here: //registry/:_authToken lines
# belong in a file named by NPM_CONFIG_USERCONFIG that is never tracked.
# Keys from workspaces/config/lib/definitions/definitions.js in npm/cli.

# Write "1.2.3", not "^1.2.3". The manifest then says what the lock file
# says, and a fresh install cannot drift a minor version.
save-exact=true
# No funding banner after every install.
fund=false
# `npm audit` exits non-zero only from high upward.
audit-level=high
# Refuse a package whose engines field rejects the current Node.
engine-strict=true
package-lock=true
# No "new npm version available" nag.
update-notifier=false
init-license=MIT

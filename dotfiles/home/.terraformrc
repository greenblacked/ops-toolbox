# Terraform CLI configuration (~/.terraformrc, or $TF_CLI_CONFIG_FILE).
#
# Nothing here is a credential. `terraform login` writes tokens to
# ~/.terraform.d/credentials.tfrc.json, which stays out of the repository;
# in CI use TF_TOKEN_app_terraform_io instead of either.
# Verified against terraform/cli/config/config-file in the HashiCorp docs.

# One download of each provider shared by every working directory. The
# provider set for a GKE project is hundreds of megabytes per `init`
# without this. Terraform does not create the directory: mkdir -p it once.
# Never point it at a filesystem_mirror directory.
plugin_cache_dir = "$HOME/.terraform.d/plugin-cache"

# Deliberately NOT set: plugin_cache_may_break_dependency_lock_file. It lets
# `init` record only the local platform's hash in .terraform.lock.hcl, and
# the next `init` on a Linux runner fails. Commit the lock file instead.

# No version and security-bulletin call to checkpoint.hashicorp.com on every
# run. Homebrew and tfenv keep the binary current; the CLI does not need to
# phone home to tell you so.
disable_checkpoint = true

# A private provider mirror goes here when one exists. include/exclude take
# provider-address globs; the direct block keeps everything else on the
# public registry.
# provider_installation {
#   network_mirror {
#     url     = "https://artifactory.example.com/artifactory/api/terraform/providers/"
#     include = ["registry.terraform.io/hashicorp/*"]
#   }
#   direct {
#     exclude = ["registry.terraform.io/hashicorp/*"]
#   }
# }

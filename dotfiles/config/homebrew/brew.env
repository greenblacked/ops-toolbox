# Homebrew. Read from $XDG_CONFIG_HOME/homebrew/brew.env only when
# XDG_CONFIG_HOME is exported before brew runs - put
#   export XDG_CONFIG_HOME="$HOME/.config"
# in ~/.zshenv, not ~/.zshrc, so GUI-launched terminals see it too. Without
# it Homebrew reads ~/.homebrew/brew.env instead.
#
# Format, from bin/brew: KEY=value, one per line, exported verbatim. No
# quotes, no ~ or $HOME, no $(...). A variable must have a value to count.
# Each one is in docs/Manpage.md under ENVIRONMENT.

# --- privacy ---------------------------------------------------------------
HOMEBREW_NO_ANALYTICS=1
# Refuse a download that redirects from HTTPS to plain HTTP.
HOMEBREW_NO_INSECURE_REDIRECT=1
# Not set: HOMEBREW_CASK_OPTS=--require-sha. Casks pinned to :latest ship
# without a checksum, and several in this repository's Brewfile are, so it
# would refuse them. Opt in per machine if none of yours are.

# --- update and cleanup cadence -------------------------------------------
# Auto-update at most weekly instead of daily; installs stop stalling on a
# fetch, and stay_fresh.sh runs a real `brew update` on its own schedule.
HOMEBREW_AUTO_UPDATE_SECS=604800
# No "New formulae" wall after each update.
HOMEBREW_NO_UPDATE_REPORT_NEW=1
# Cached downloads older than 30 days go (default 120); the cache reaches
# tens of gigabytes otherwise.
HOMEBREW_CLEANUP_MAX_AGE_DAYS=30
# `brew install foo` does not silently upgrade a foo that is already there.
HOMEBREW_NO_INSTALL_UPGRADE=1
# Track the latest stable tag of brew itself rather than main.
HOMEBREW_UPDATE_TO_TAG=1

# --- output ----------------------------------------------------------------
# No "Hint: set HOMEBREW_..." lines; this file is the hint taken.
HOMEBREW_NO_ENV_HINTS=1
# Per-formula timings at the end of a run, to spot a slow source build.
HOMEBREW_DISPLAY_INSTALL_TIMES=1
HOMEBREW_BAT=1
HOMEBREW_EDITOR=nvim
# Default 3; a corporate proxy drops connections.
HOMEBREW_CURL_RETRIES=5
# `brew bundle dump` leaves VS Code extensions out.
HOMEBREW_BUNDLE_DUMP_NO_VSCODE=1

# A GitHub token raises API limits but does not belong here: export
# HOMEBREW_GITHUB_API_TOKEN from the keychain in ~/.zshenv instead.
